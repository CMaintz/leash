{
  "name": "@cmaintz/leash",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Jev-powered, real-time output-quality guardrail for coding agents. Keeps an agent's edits on a short leash: judges every turn against your un-lintable project rules and tells it which one it broke.",
  "license": "MIT",
  "author": "Christoffer Maintz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CMaintz/leash.git"
  },
  "homepage": "https://github.com/CMaintz/leash#readme",
  "bugs": {
    "url": "https://github.com/CMaintz/leash/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "leash": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check \"**/*.ts\"",
    "format": "prettier --write \"**/*.ts\" && eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jev",
    "typesafe",
    "coding-agent",
    "claude-code",
    "code-review",
    "guardrail",
    "lint",
    "agents",
    "code-quality"
  ],
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.36.0",
    "jscpd": "^5.3.2",
    "knip": "^6.37.0",
    "prettier": "^3.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.1"
  }
}
